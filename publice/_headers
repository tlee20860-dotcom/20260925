# ============================================================================
# Cloudflare Pages _headers
# v8.5.6 — 方案 A：移除 ?v= 戳記，改用 HTTP 快取控制
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ----------------------------------------------------------------------------
# HTML：每次請求驗證 ETag（改版即時生效）
# ----------------------------------------------------------------------------
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ----------------------------------------------------------------------------
# CSS / JS：最長快取 60 秒
# ----------------------------------------------------------------------------
/style.css
  Cache-Control: public, max-age=60

/js/simulation.js
  Cache-Control: public, max-age=60

/js/core.js
  Cache-Control: public, max-age=60

/js/firebase.js
  Cache-Control: public, max-age=60

/js/auth.js
  Cache-Control: public, max-age=60

/js/data.js
  Cache-Control: public, max-age=60

/js/ui.js
  Cache-Control: public, max-age=60

/js/summary.js
  Cache-Control: public, max-age=60

/js/main.js
  Cache-Control: public, max-age=60