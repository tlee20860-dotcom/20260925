# ============================================================================
# Cloudflare Pages _headers
# v8.5
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ----------------------------------------------------------------------------
# HTML：短快取，改版立即生效
# ----------------------------------------------------------------------------
/index.html
  Cache-Control: public, max-age=60

/
  Cache-Control: public, max-age=60

# ----------------------------------------------------------------------------
# CSS：中等快取（5 分鐘）
# ----------------------------------------------------------------------------
/style.css
  Cache-Control: public, max-age=300

# ----------------------------------------------------------------------------
# JS：全部改為 5 分鐘快取（避免舊版永久快取）
# ----------------------------------------------------------------------------
/js/simulation.js
  Cache-Control: public, max-age=300

/js/core.js
  Cache-Control: public, max-age=300

/js/firebase.js
  Cache-Control: public, max-age=300

/js/auth.js
  Cache-Control: public, max-age=300

/js/data.js
  Cache-Control: public, max-age=300

/js/ui.js
  Cache-Control: public, max-age=300

/js/summary.js
  Cache-Control: public, max-age=300

/js/main.js
  Cache-Control: public, max-age=300