/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/js/simulation.js
  Cache-Control: public, max-age=31536000, immutable

/js/core.js
  Cache-Control: public, max-age=31536000, immutable

/js/firebase.js
  Cache-Control: public, max-age=86400

/js/auth.js
  Cache-Control: public, max-age=86400

/js/data.js
  Cache-Control: public, max-age=86400

/js/ui.js
  Cache-Control: public, max-age=3600

/js/main.js
